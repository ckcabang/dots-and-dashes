{
  "uid": "dots-and-dashes-key-journey",
  "title": "Dots & Dashes: key journey",
  "description": "Logging an Entry on today's Daily Log: what the save alerts and the canary watch (docs/runbooks/README.md).",
  "tags": [
    "dots-and-dashes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "hide": 0,
        "current": {}
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "prod,dev",
        "current": {
          "text": "prod",
          "value": "prod",
          "selected": true
        },
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          },
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "image",
        "label": "Image",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(entry_saves_total{job=\"$env/dots-and-dashes\"}, image)",
          "refId": "image"
        },
        "definition": "label_values(entry_saves_total{job=\"$env/dots-and-dashes\"}, image)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 0,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Save failure rate",
      "description": "Failed saves over saved and failed ones; refused saves (blank text) count as neither. The Save failures alert fires above 5% over 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "custom": {
            "axisSoftMin": 0,
            "axisSoftMax": 1,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(entry_saves_total{job=\"$env/dots-and-dashes\", image=~\"$image\", outcome=\"failed\"}[$__rate_interval])) or vector(0)) / sum(rate(entry_saves_total{job=\"$env/dots-and-dashes\", image=~\"$image\", outcome=~\"saved|failed\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "range": true,
          "editorMode": "code",
          "exemplar": false
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Saves by outcome",
      "description": "Entry saves per second, by outcome: saved, refused or failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(entry_saves_total{job=\"$env/dots-and-dashes\", image=~\"$image\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "editorMode": "code",
          "exemplar": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 save latency",
      "description": "The Save latency alert fires above 1s. Each exemplar's tooltip shows a save's trace_id: open it in Explore → Tempo.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(entry_save_duration_seconds_bucket{job=\"$env/dots-and-dashes\", image=~\"$image\", outcome=~\"saved|failed\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "editorMode": "code",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Canary pass rate",
      "description": "Share of the selected environment's Synthetic Monitoring canary runs that passed: every minute on prod, every 15 minutes on dev (so dev's line joins sparse points). The Image filter doesn't apply: a probe can't know the image. The Canary failing alert fires below 80%, over 5 minutes on prod and 35 minutes on dev.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "spanNulls": true,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg(avg_over_time(probe_success{job=\"dots-and-dashes-canary-$env\"}[$__rate_interval]))",
          "legendFormat": "pass rate",
          "range": true,
          "editorMode": "code",
          "exemplar": false
        }
      ]
    }
  ]
}
