#!/usr/bin/env python3
"""Read Grafana's HTTP API with the Viewer-role token: GET only, at its own URL.

    scripts/on-call/grafana <api path, relative, with any query string>

For example:

    scripts/on-call/grafana 'api/prometheus/grafana/api/v1/rules'
    scripts/on-call/grafana 'api/datasources/proxy/uid/grafanacloud-prom/api/v1/query?query=up'

In the On-call workflow GRAFANA_URL comes from the environment and
GRAFANA_VIEWER_TOKEN from its file in ON_CALL_TOKENS. A local agent reads both
from the .env file scripts/provision-oncall writes (ENV_FILE overrides its
path). Prints the response body; a status other than 2xx fails. A refusal
never repeats the path back, and any token in Grafana's answer is redacted.
"""

import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

from on_call_lib import known_secrets, token

ROOT = Path(__file__).resolve().parents[2]


def redacted(text: str) -> str:
    for secret in known_secrets():
        text = text.replace(secret, "[redacted]")
    return text


def from_env_file(key: str) -> str:
    """KEY's value in the .env file, with the wizard's single quotes undone."""
    path = Path(os.environ.get("ENV_FILE") or ROOT / ".env")
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return ""
    value = ""
    for line in lines:
        if line.startswith(f"{key}="):
            value = line.split("=", 1)[1]
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
        value = value[1:-1].replace("'\\''", "'")
    return value


def setting(key: str) -> str:
    return os.environ.get(key) or from_env_file(key)


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    (path,) = argv
    if path.startswith("/") or "://" in path or ".." in path.split("?")[0].split("/"):
        print("Refused: the path must be relative to Grafana's own URL", file=sys.stderr)
        return 2
    url = setting("GRAFANA_URL").rstrip("/")
    viewer_token = token("GRAFANA_VIEWER_TOKEN") or from_env_file("GRAFANA_VIEWER_TOKEN")
    if not (url and viewer_token):
        print(
            "GRAFANA_URL and GRAFANA_VIEWER_TOKEN must be set (scripts/provision-oncall)",
            file=sys.stderr,
        )
        return 2
    request = urllib.request.Request(
        f"{url}/{path}",
        headers={
            "Authorization": f"Bearer {viewer_token}",
            "Accept": "application/json",
        },
    )
    # No redirects: urllib would send the token on to wherever one points.
    opener = urllib.request.build_opener(NoRedirects)
    try:
        with opener.open(request, timeout=60) as response:
            sys.stdout.write(redacted(response.read().decode()))
    except urllib.error.HTTPError as error:
        body = redacted(error.read().decode()[:2000])
        print(f"Grafana answered {error.code}: {body}", file=sys.stderr)
        return 1
    except Exception as error:  # no traceback: it would quote the request
        print(f"Couldn't reach Grafana: {type(error).__name__}", file=sys.stderr)
        return 1
    return 0


class NoRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):  # type: ignore[no-untyped-def]
        return None


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
