#!/usr/bin/env python3
"""Read Grafana's HTTP API with the Viewer-role token: GET only, at its own URL.

    scripts/on-call/grafana <api path, relative, with any query string>

For example:

    scripts/on-call/grafana 'api/prometheus/grafana/api/v1/rules'
    scripts/on-call/grafana 'api/datasources/proxy/uid/grafanacloud-prom/api/v1/query?query=up'

GRAFANA_URL and GRAFANA_VIEWER_TOKEN come from the environment (the On-call
workflow sets them from a repo variable and a secret) or, for a local agent,
from the .env file scripts/provision-oncall writes (ENV_FILE overrides its
path). Prints the response body; a status other than 2xx fails.
"""

import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def from_env_file(key: str) -> str:
    """KEY's value in the .env file, with the wizard's single quotes undone."""
    path = Path(os.environ.get("ENV_FILE") or ROOT / ".env")
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return ""
    value = ""
    for line in lines:
        if line.startswith(f"{key}="):
            value = line.split("=", 1)[1]
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
        value = value[1:-1].replace("'\\''", "'")
    return value


def setting(key: str) -> str:
    return os.environ.get(key) or from_env_file(key)


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    (path,) = argv
    if path.startswith("/") or "://" in path or ".." in path.split("?")[0].split("/"):
        print(f"Refused: {path!r} must be a path relative to Grafana's own URL", file=sys.stderr)
        return 2
    url, token = setting("GRAFANA_URL").rstrip("/"), setting("GRAFANA_VIEWER_TOKEN")
    if not (url and token):
        print("GRAFANA_URL and GRAFANA_VIEWER_TOKEN must be set (scripts/provision-oncall)",
              file=sys.stderr)
        return 2
    request = urllib.request.Request(f"{url}/{path}", headers={
        "Authorization": f"Bearer {token}", "Accept": "application/json",
    })
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            sys.stdout.write(response.read().decode())
    except urllib.error.HTTPError as error:
        print(f"Grafana answered {error.code}: {error.read().decode()[:2000]}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
