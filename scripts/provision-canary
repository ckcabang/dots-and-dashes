#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────



# One-time setup of the canaries and the user-impact alerts (issue #21): a
# Canary User on prod and one on dev, their passwords as Synthetic Monitoring
# secrets, two scripted (k6) checks running monitoring/canary.js (prod every
# minute, dev every 15 minutes), and the alert rules and dashboard in
# monitoring/ imported into Grafana Cloud. Then two firing tests on dev. Run it
# once prod is up (scripts/provision-prod) and both apps export telemetry.
# Safe to re-run: Grafana imports overwrite, existing Canary Users and checks
# are kept.
#
# Each Canary User's password is typed here once and held only in this shell:
# it goes to create-user on stdin, never on a command line, and you type it
# into Grafana yourself. Use ones from your password manager.
#
# It ends by printing the evidence to paste back on the PR: both logins, both
# check IDs, the imported rule UIDs, the dashboard URL and the firing tests.

APP=dots-and-dashes
DEV_APP=dots-and-dashes-dev
CANARY_EMAIL=canary@dots-and-dashes.invalid
# The checks' job names: the canary alerts and panel select probe_success on them.
CANARY_JOB_PROD=dots-and-dashes-canary-prod
CANARY_JOB_DEV=dots-and-dashes-canary-dev
FOLDER_UID=dots-and-dashes
RULE_GROUP=key-journey
SM_PATH=a/grafana-synthetic-monitoring-app
EVIDENCE=()

# app_for ENV / password_for ENV: the Fly app, and the Canary User's password.
app_for() { if [[ "$1" == prod ]]; then echo "$APP"; else echo "$DEV_APP"; fi; }
password_for() { if [[ "$1" == prod ]]; then printf '%s' "$CANARY_PASSWORD"; else printf '%s' "$CANARY_DEV_PASSWORD"; fi; }

# with_timeout SECONDS CMD...: CMD, killed after SECONDS where `timeout` exists
# (macOS has none by default: there it just runs).
with_timeout() {
  local seconds="$1"; shift
  if command -v timeout >/dev/null 2>&1; then timeout "$seconds" "$@"; else "$@"; fi
}

# create_canary ENV: create ENV's Canary User on its app's Machine, the
# password on stdin. Succeeds if it was created or already exists.
create_canary() {
  local app out
  app=$(app_for "$1")
  # Wake the Machine: dev auto-stops, and flyctl ssh needs a started VM.
  curl -s -o /dev/null --max-time 90 "https://$app.fly.dev/login" || true
  # Killed after 2 minutes: if flyctl never hands the pipe to the Machine,
  # create-user would wait on stdin forever. The caller then falls back to --pty.
  if out=$(password_for "$1" | with_timeout 120 flyctl ssh console -a "$app" \
      -C "/app/.venv/bin/dots-and-dashes create-user --canary --email $CANARY_EMAIL --timezone UTC --password-stdin" 2>&1); then
    say "$out"
    return 0
  fi
  if grep -q "already exists" <<<"$out"; then
    note "The Canary User already exists on $app: left as it is."
    note "The password you typed must be the one it was made with."
    return 0
  fi
  say "$out"
  return 1
}

# login_status ENV: what ENV's app answers its Canary User's log in, the
# password sent from stdin; 000 when it doesn't answer.
login_status() {
  password_for "$1" | curl -s -o /dev/null -w '%{http_code}' --max-time 90 \
    --data-urlencode "email=$CANARY_EMAIL" --data-urlencode "password@-" \
    "https://$(app_for "$1").fly.dev/login" || true
}

# canary_user_stage ENV: create ENV's Canary User, falling back to the CLI's
# own prompt, and finish only once it logs in.
canary_user_stage() {
  local env="$1" app status
  app=$(app_for "$env")
  say "Runs create-user --canary in $app's Machine, the password piped in on stdin."
  if confirm "Create $CANARY_EMAIL on $app?"; then
    if ! create_canary "$env"; then
      warn "That didn't work. Create it by hand instead: the CLI asks for the password."
      note "If flyctl says no started VMs, open https://$app.fly.dev/login first to wake it."
      step "flyctl ssh console -a $app --pty -C \"/app/.venv/bin/dots-and-dashes create-user --canary --email $CANARY_EMAIL --timezone UTC\""
      pause "Done? Press Enter"
    fi
  fi
  status=$(login_status "$env")
  if [[ "$status" == 303 ]]; then
    say "${GREEN}✓${RESET} The Canary User logs in to $env (303)."
    EVIDENCE+=("Canary User $CANARY_EMAIL logs in to https://$app.fly.dev: POST /login answered 303")
  else
    warn "Logging in as the Canary User on $env answered $status, not 303."
    warn "Its check would fail. Fix this before going on (Ctrl-C), then re-run."
    EVIDENCE+=("Canary User on $env: POST /login answered $status, not 303")
  fi
  pause
}

# check_stage ENV FREQUENCY TIMEOUT: create (or keep and update) ENV's check.
check_stage() {
  local env="$1" frequency="$2" timeout="$3" key job app script existing kept=no
  key=$([[ "$env" == prod ]] && echo CANARY_CHECK_ID || echo CANARY_DEV_CHECK_ID)
  job=$([[ "$env" == prod ]] && echo "$CANARY_JOB_PROD" || echo "$CANARY_JOB_DEV")
  app=$(app_for "$env")
  # The script as this check runs it: the one ENVIRONMENT line set to ENV.
  script=$(mktemp)
  sed "s/const ENVIRONMENT = __ENV.CANARY_ENV || 'prod';/const ENVIRONMENT = __ENV.CANARY_ENV || '$env';/" \
    monitoring/canary.js > "$script"
  existing=$(_existing "$key" || true)
  if [[ -n "$existing" ]] && confirm "Check $existing exists from a past run. Keep it, updating its script?"; then
    # One check per environment: a second would double its saves and quota.
    printf -v "$key" '%s' "$existing"
    kept=yes
    open_url "$GRAFANA_URL/$SM_PATH/checks/$existing/edit"
    step "Replace its script with the one below. Keep job $job, then save."
  else
    open_url "$GRAFANA_URL/$SM_PATH/checks/new/scripted"
    step "This is Synthetics → Checks → Create new check → Scripted."
    step "Job name: $job (the alert and dashboard select on it)."
    step "Target / instance: https://$app.fly.dev"
    step "Script: replace the example with the one below."
    step "Probe locations: one, the nearest to Fly's iad (e.g. North Virginia)."
    step "Frequency: $frequency. Timeout: $timeout."
    step "If the form has a Test button, run it: it should pass. Save the check."
    note "Field names here are from the Synthetic Monitoring app's code; the form's"
    note "layout may differ. Each run counts against your plan's execution quota."
  fi
  if copy_file "$script"; then
    step "The script is on your clipboard: monitoring/canary.js with ENVIRONMENT '$env'."
  elif [[ "$env" == prod ]]; then
    step "The script: the whole of monitoring/canary.js, as it is."
  else
    step "The script: the whole of monitoring/canary.js, with its one line"
    step "  const ENVIRONMENT = __ENV.CANARY_ENV || 'prod';  changed to end in 'dev';"
  fi
  rm -f "$script"
  if [[ "$kept" == no ]]; then
    ask "$key" "The check's ID (the number at the end of its page's URL, /checks/<id>):"
  fi
  write_env "$key" "${!key}"
  EVIDENCE+=("Synthetic Monitoring check $job, every $frequency, timeout $timeout: $GRAFANA_URL/$SM_PATH/checks/${!key}")
}

# What the EXIT trap cleans up: the chaos secret a firing test has staged on
# dev, the cookie jar, and the Grafana token's file.
STAGED_SECRET=""
JAR=""
AUTH_FILE=""

# cleanup runs on every exit, Ctrl-C and errors included, so a firing test
# that stops early never leaves dev failing or slowing its saves.
cleanup() {
  trap '' INT TERM   # a second Ctrl-C mustn't cut the clean-up short
  if [[ -n "$STAGED_SECRET" ]]; then
    warn "Unsetting $STAGED_SECRET on $DEV_APP, ending the staged incident."
    flyctl secrets unset -a "$DEV_APP" "$STAGED_SECRET" \
      || warn "Couldn't. Run it yourself: flyctl secrets unset -a $DEV_APP $STAGED_SECRET"
    STAGED_SECRET=""
  fi
  rm -f "$JAR" "$AUTH_FILE"
}

# grafana METHOD PATH [curl args...]: call Grafana's HTTP API with the token,
# kept in a file so it never shows in the process list.
grafana() {
  local method="$1" path="$2"; shift 2
  curl -sS -X "$method" -H "@$AUTH_FILE" -H 'Content-Type: application/json' \
    "$GRAFANA_URL/$path" "$@"
}

# render FILE: the file with the stack's URL and Prometheus data source filled in.
render() {
  sed -e "s|\${GRAFANA_URL}|$GRAFANA_URL|g" -e "s|\${PROMETHEUS_UID}|$PROMETHEUS_UID|g" "$1"
}

# copy_file FILE: put FILE on the clipboard if this machine has a way to.
copy_file() {
  if   command -v clip.exe >/dev/null 2>&1; then clip.exe < "$1"
  elif command -v pbcopy   >/dev/null 2>&1; then pbcopy < "$1"
  elif command -v wl-copy  >/dev/null 2>&1; then wl-copy < "$1"
  elif command -v xclip    >/dev/null 2>&1; then xclip -selection clipboard < "$1"
  else return 1; fi
}

json_field() { python3 -c "import json,sys; print(json.load(sys.stdin)$1)"; }

# dev_secret_state NAME: "set" or "unset" for a Fly secret on dev now, or
# "unknown" when the listing itself fails, which must never read as unset.
dev_secret_state() {
  local list
  if ! list=$(flyctl secrets list -a "$DEV_APP" --json 2>/dev/null); then
    echo unknown; return 0
  fi
  if [[ "$list" == *"\"$1\""* ]]; then echo set; else echo unset; fi
}

# drive_saves: log 30 Entries on dev as its Canary User and delete each saved
# one. A request that fails, or doesn't answer at all, counts as failed.
drive_saves() {
  local body id
  saved=0 failed=0
  JAR=$(mktemp)
  password_for dev | curl -s -o /dev/null -c "$JAR" --max-time 90 --data-urlencode \
    "email=$CANARY_EMAIL" --data-urlencode "password@-" "https://$DEV_APP.fly.dev/login" || true
  for _ in $(seq 1 30); do
    body=$(curl -s -b "$JAR" -H 'Content-Type: application/json' -d '{"text":"canary check"}' \
      --max-time 30 -w '\n%{http_code}' "https://$DEV_APP.fly.dev/api/entries" || true)
    if [[ "${body##*$'\n'}" == 201 ]]; then
      saved=$((saved + 1))
      id=$(json_field '["id"]' <<<"${body%$'\n'*}" 2>/dev/null || true)
      if [[ "$id" =~ ^[0-9]+$ ]]; then
        curl -s -o /dev/null -b "$JAR" --max-time 30 -X DELETE \
          "https://$DEV_APP.fly.dev/api/entries/$id" || true
      fi
    else
      failed=$((failed + 1))
    fi
  done
  rm -f "$JAR"; JAR=""
}

# rule_state TITLE: the alert rule's state now (inactive, pending or firing).
rule_state() {
  grafana GET api/prometheus/grafana/api/v1/rules | RULE="$1" python3 -c '
import json, os, sys
for g in json.load(sys.stdin)["data"]["groups"]:
    for r in g["rules"]:
        if r["name"] == os.environ["RULE"]:
            print(r["state"])' 2>/dev/null || true
}

# firing_test SECRET VALUE RULE: stage an incident on dev with the chaos
# SECRET, drive saves, wait up to 10 minutes for RULE to fire, end it. Refuses
# to stage over a switch someone already set on dev.
firing_test() {
  local secret="$1" value="$2" rule="$3" state="" fired_at="" existing
  existing=$(dev_secret_state "$secret")
  if [[ "$existing" == set ]]; then
    warn "$secret is already set on $DEV_APP, perhaps by someone staging an incident."
    warn "Not staging over it. Unset it once that's done, then re-run this wizard:"
    step "flyctl secrets unset -a $DEV_APP $secret"
    EVIDENCE+=("Firing test $secret: not run, $secret was already set on dev")
    return 0
  elif [[ "$existing" != unset ]]; then
    warn "Couldn't list $DEV_APP's secrets, so can't tell whether $secret is set."
    warn "Not staging blind. Check flyctl works (flyctl secrets list -a $DEV_APP), then re-run."
    EVIDENCE+=("Firing test $secret: not run, couldn't list dev's secrets; '$rule' unproven")
    return 0
  fi
  STAGED_SECRET="$secret"
  flyctl secrets set -a "$DEV_APP" "$secret=$value"
  drive_saves
  say "Saves on dev: $saved saved, $failed failed."
  say "Waiting for '$rule' to fire (it evaluates every minute, then holds 1m)…"
  for _ in $(seq 1 20); do
    state=$(rule_state "$rule")
    note "  $rule: ${state:-unknown}"
    if [[ "$state" == firing ]]; then fired_at=$(date -u +%FT%TZ); break; fi
    sleep 30
  done
  EVIDENCE+=("Firing test on dev, $secret=$value: $saved saved, $failed failed; '$rule' state: ${state:-unknown}${fired_at:+ at $fired_at}")
  say "Ending the staged incident."
  flyctl secrets unset -a "$DEV_APP" "$secret"
  STAGED_SECRET=""
}

# firing_stage SECRET VALUE RULE: the stage around firing_test, which needs
# dev's Canary User to log in.
firing_stage() {
  if [[ "$(login_status dev)" != 303 ]]; then
    warn "Dev's Canary User can't log in, so this firing test can't run, and the"
    warn "criterion that '$3' fires stays unproven on the PR."
    say "Fix dev's Canary User (stage 4's command), then re-run the whole wizard."
    note "If flyctl says no started VMs, open https://$DEV_APP.fly.dev/login first to wake it."
    step "flyctl ssh console -a $DEV_APP --pty -C \"/app/.venv/bin/dots-and-dashes create-user --canary --email $CANARY_EMAIL --timezone UTC\""
    step "scripts/provision-canary"
    note "Re-running is safe: it keeps the Canary Users, checks and imports already done."
    EVIDENCE+=("Firing test $1: skipped, dev's Canary User can't log in; '$3' unproven")
  elif confirm "Stage it now? It takes about five minutes."; then
    firing_test "$@"
  fi
  pause
}

run_wizard() {

cd "$(dirname "$0")/.."

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

TOTAL_STAGES=11

banner "The canaries and the user-impact alerts"

stage "Tools, logins and your Grafana stack"
for tool in flyctl curl python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    warn "$tool isn't installed. Install it, then re-run this wizard."
    exit 1
  fi
done
if ! flyctl auth whoami >/dev/null 2>&1; then
  say "Log in to Fly.io in the browser that opens."
  flyctl auth login
fi
say "Logged in to Fly.io as $(flyctl auth whoami)."
say "Your Grafana Cloud stack's URL is the address you open Grafana at."
ask GRAFANA_URL "Grafana stack URL (https://<stack>.grafana.net):"
GRAFANA_URL=${GRAFANA_URL%/}
write_env GRAFANA_URL "$GRAFANA_URL"

stage "The Canary Users' passwords"
say "Each canary logs in as $CANARY_EMAIL, prod's on prod and dev's on dev,"
say "each with a password of its own. Pick them from your password manager:"
say "you type each again into Grafana as a secret."
note "They're held in this shell only, never written to a file."
for env in prod dev; do
  var=$([[ "$env" == prod ]] && echo CANARY_PASSWORD || echo CANARY_DEV_PASSWORD)
  while :; do
    printf -v "$var" '%s' ""
    ask_secret "$var" "$env Canary User's password (hidden):"
    ask_secret PASSWORD_AGAIN "Again (hidden):"
    if [[ -z "${!var}" ]]; then warn "It can't be empty."
    elif [[ "${!var}" != "$PASSWORD_AGAIN" ]]; then warn "They don't match."
    else break; fi
  done
done
unset PASSWORD_AGAIN
if [[ "$CANARY_PASSWORD" == "$CANARY_DEV_PASSWORD" ]]; then
  warn "They're the same: a leak on dev then logs in on prod. Fine for now; change later."
fi

stage "Create the Canary User on prod"
canary_user_stage prod

stage "Create the Canary User on dev"
say "Dev's canary check and the firing tests at the end log in as it."
canary_user_stage dev

stage "Store the passwords as Synthetic Monitoring secrets"
say "The canary script reads secrets.get('canary-password') on prod's check and"
say "secrets.get('canary-password-dev') on dev's."
open_url "$GRAFANA_URL/$SM_PATH/config/secrets"
step "This is Testing & synthetics → Synthetics → Config → the Secrets tab."
step "Secret canary-password: prod's Canary User password."
step "Secret canary-password-dev: dev's Canary User password."
step "Description for each: the Canary User's password (scripts/provision-canary)."
step "One already there from a past run: edit it and set the password you typed now."
note "Not sure of the current button names: the Synthetic Monitoring app hides the"
note "Secrets tab behind a feature flag. If your stack has no Secrets tab, stop here"
note "and say so on the PR; the script needs a secret source to read the password."
pause "Both saved? Press Enter"

stage "The prod canary check"
check_stage prod "1 minute" "30 seconds"

stage "The dev canary check"
note "Dev stops when idle, so a run may first wait for its app and Postgres to"
note "start: the timeout covers that cold start."
check_stage dev "15 minutes (900 s)" "2 minutes (120 s)"

stage "A Grafana token to import the alerts and dashboard"
open_url "$GRAFANA_URL/org/serviceaccounts"
step "This is Administration → Users and access → Service accounts."
step "Add service account: name dots-and-dashes-provisioning, role Admin."
step "If it's there from a past run, open it instead and add a new token to it."
step "Add service account token, no expiry needed, Generate, copy it."
note "Admin, because the alert provisioning API needs it. Delete the token after."
ask_secret GRAFANA_TOKEN "Service account token (hidden):"
AUTH_FILE=$(mktemp)
chmod 600 "$AUTH_FILE"
printf 'Authorization: Bearer %s\n' "$GRAFANA_TOKEN" > "$AUTH_FILE"
unset GRAFANA_TOKEN
code=$(grafana GET api/folders -o /dev/null -w '%{http_code}')
if [[ "$code" != 200 ]]; then
  warn "Grafana answered $code to the token: check the URL and token, then re-run."
  exit 1
fi
say "${GREEN}✓${RESET} The token works."

stage "Import the alert rules and dashboard"
if [[ "$(grafana GET api/datasources/uid/grafanacloud-prom -o /dev/null -w '%{http_code}')" == 200 ]]; then
  PROMETHEUS_UID=grafanacloud-prom
  say "Prometheus data source: grafanacloud-prom, Grafana Cloud's own."
else
  note "No data source with UID grafanacloud-prom. Your Prometheus data sources:"
  grafana GET api/datasources | python3 -c '
import json, sys
for d in json.load(sys.stdin):
    if d.get("type") == "prometheus":
        print("    ", d["uid"], " ", d["name"])'
  ask PROMETHEUS_UID "UID of the one holding the apps' metrics (grafanacloud-<stack>-prom):"
fi
say "Folder $FOLDER_UID:"
grafana POST api/folders -o /dev/null -w '  answered %{http_code} (409 or 412: already there)\n' \
  -d "{\"uid\":\"$FOLDER_UID\",\"title\":\"Dots & Dashes\"}"
say "Rule group $RULE_GROUP, from monitoring/alert-rules.json:"
# X-Disable-Provenance keeps the rules editable in the UI.
rules=$(render monitoring/alert-rules.json | grafana PUT \
  "api/v1/provisioning/folder/$FOLDER_UID/rule-groups/$RULE_GROUP" \
  -H 'X-Disable-Provenance: true' --data-binary @- -w '\n%{http_code}')
if [[ "${rules##*$'\n'}" != 200 ]]; then
  warn "Grafana refused the rule group:"; say "$rules"; exit 1
fi
uids=$(grafana GET "api/v1/provisioning/folder/$FOLDER_UID/rule-groups/$RULE_GROUP" \
  | python3 -c 'import json, sys; print(" ".join(r["uid"] for r in json.load(sys.stdin)["rules"]))')
say "${GREEN}✓${RESET} Rules: $uids"
EVIDENCE+=("Alert rule UIDs in folder $FOLDER_UID, group $RULE_GROUP: $uids")
say "Dashboard, from monitoring/dashboard.json:"
dashboard=$(printf '{"dashboard":%s,"folderUid":"%s","overwrite":true}' \
  "$(cat monitoring/dashboard.json)" "$FOLDER_UID" | grafana POST api/dashboards/db --data-binary @-)
dashboard_url=$(json_field '["url"]' <<<"$dashboard" 2>/dev/null || true)
if [[ -z "$dashboard_url" ]]; then
  warn "Grafana refused the dashboard:"; say "$dashboard"; exit 1
fi
say "${GREEN}✓${RESET} $GRAFANA_URL$dashboard_url"
EVIDENCE+=("Dashboard: $GRAFANA_URL$dashboard_url")
open_url "$GRAFANA_URL$dashboard_url"
step "Pick Environment prod: Saves by outcome should show the canary's saves"
step "within a few minutes, and Canary pass rate should sit at 100%."
step "Pick dev: its canary shows a point every 15 minutes."
note "Where alerts are sent (the On-call contact point) is issue #22's; until then"
note "they show under Alerting → Alert rules, and in the default contact point."
pause

stage "Firing test: save failures on dev"
say "Sets CHAOS_SAVE_ERROR_RATE=0.5 on $DEV_APP (it restarts), saves 30 Entries"
say "there as the Canary User, waits for 'Save failures (dev)' to fire, then unsets"
say "the switch (another restart)."
note "If a dev canary run lands while half the saves fail, 'Canary failing (dev)' may"
note "fire too. That's expected: it resolves within about 30 minutes, once its 35m"
note "window holds only passing runs."
note "If the wizard stops partway, Ctrl-C included, it unsets the switch on its way out."
firing_stage CHAOS_SAVE_ERROR_RATE 0.5 "Save failures (dev)"

stage "Firing test: save latency on dev"
say "Sets CHAOS_SAVE_LATENCY_MS=1500 on $DEV_APP, so every save takes over 1.5s,"
say "saves 30 Entries, waits for 'Save latency (dev)' to fire, then unsets it."
firing_stage CHAOS_SAVE_LATENCY_MS 1500 "Save latency (dev)"
open_url "$GRAFANA_URL/alerting/list"
step "The dev alerts that fired show under Alerting → Alert rules; they resolve within ~10 minutes."

unset CANARY_PASSWORD CANARY_DEV_PASSWORD
finish
say "Paste this on the PR as the evidence:"
printf '\n'
for line in "${EVIDENCE[@]}"; do printf '  - %s\n' "$line"; done
printf '\n'
say "Delete the dots-and-dashes-provisioning token once you're done with it."
printf '\n'
}

run_wizard "$@"; exit
