#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────



# One-time setup of the canary and the user-impact alerts (issue #21): the
# Canary User on prod, its password as a Synthetic Monitoring secret, the
# scripted (k6) check that runs monitoring/canary.js every minute, and the
# alert rules and dashboard in monitoring/ imported into Grafana Cloud. Then a
# firing test on dev. Run it once prod is up (scripts/provision-prod) and
# exporting telemetry. Safe to re-run: Grafana imports overwrite, and an
# existing Canary User is left as it is.
#
# The canary's password is typed here once and held only in this shell: it
# goes to create-user on stdin, never on a command line, and you type it into
# Grafana yourself. Use one from your password manager, since you type it twice.
#
# It ends by printing the evidence to paste back on the PR: the check ID, the
# imported rule UIDs, the dashboard URL and the firing test's result.

APP=dots-and-dashes
DEV_APP=dots-and-dashes-dev
CANARY_EMAIL=canary@dots-and-dashes.invalid
# The check's job name: the canary alert and panel select probe_success on it.
CANARY_JOB=dots-and-dashes-canary
FOLDER_UID=dots-and-dashes
RULE_GROUP=key-journey
DASHBOARD_UID=dots-and-dashes-key-journey
SM_PATH=a/grafana-synthetic-monitoring-app
EVIDENCE=()

# create_canary APP: create the Canary User on APP's Machine, the password on
# stdin. Succeeds if it was created or already exists.
create_canary() {
  local app="$1" out
  if out=$(printf '%s\n' "$CANARY_PASSWORD" | flyctl ssh console -a "$app" \
      -C "/app/.venv/bin/dots-and-dashes create-user --canary --email $CANARY_EMAIL --timezone UTC --password-stdin" 2>&1); then
    say "$out"
    return 0
  fi
  if grep -q "already exists" <<<"$out"; then
    note "The Canary User already exists on $app: left as it is."
    note "The password you typed must be the one it was made with."
    return 0
  fi
  say "$out"
  return 1
}

# login_status URL: what the app answers the Canary User's log in, the password
# sent from stdin.
login_status() {
  printf '%s' "$CANARY_PASSWORD" | curl -s -o /dev/null -w '%{http_code}' \
    --data-urlencode "email=$CANARY_EMAIL" --data-urlencode "password@-" "$1/login"
}

# grafana METHOD PATH [curl args...]: call Grafana's HTTP API with the token,
# kept in a file so it never shows in the process list.
grafana() {
  local method="$1" path="$2"; shift 2
  curl -sS -X "$method" -H "@$AUTH_FILE" -H 'Content-Type: application/json' \
    "$GRAFANA_URL/$path" "$@"
}

# render FILE: the file with the stack's URL and Prometheus data source filled in.
render() {
  sed -e "s|\${GRAFANA_URL}|$GRAFANA_URL|g" -e "s|\${PROMETHEUS_UID}|$PROMETHEUS_UID|g" "$1"
}

# copy_file FILE: put FILE on the clipboard if this machine has a way to.
copy_file() {
  if   command -v clip.exe >/dev/null 2>&1; then clip.exe < "$1"
  elif command -v pbcopy   >/dev/null 2>&1; then pbcopy < "$1"
  elif command -v wl-copy  >/dev/null 2>&1; then wl-copy < "$1"
  elif command -v xclip    >/dev/null 2>&1; then xclip -selection clipboard < "$1"
  else return 1; fi
}

json_field() { python3 -c "import json,sys; print(json.load(sys.stdin)$1)"; }

run_wizard() {

cd "$(dirname "$0")/.."

TOTAL_STAGES=9

banner "The canary and the user-impact alerts"

stage "Tools, logins and your Grafana stack"
for tool in flyctl curl python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    warn "$tool isn't installed. Install it, then re-run this wizard."
    exit 1
  fi
done
if ! flyctl auth whoami >/dev/null 2>&1; then
  say "Log in to Fly.io in the browser that opens."
  flyctl auth login
fi
say "Logged in to Fly.io as $(flyctl auth whoami)."
say "Your Grafana Cloud stack's URL is the address you open Grafana at."
ask GRAFANA_URL "Grafana stack URL (https://<stack>.grafana.net):"
GRAFANA_URL=${GRAFANA_URL%/}
write_env GRAFANA_URL "$GRAFANA_URL"

stage "The Canary User's password"
say "The canary logs in to prod as $CANARY_EMAIL with this password."
say "Pick one from your password manager: you type it again into Grafana."
note "It's held in this shell only, never written to a file."
while :; do
  CANARY_PASSWORD=""
  ask_secret CANARY_PASSWORD "Canary password (hidden):"
  ask_secret CANARY_PASSWORD_AGAIN "Again (hidden):"
  if [[ -z "$CANARY_PASSWORD" ]]; then warn "It can't be empty."
  elif [[ "$CANARY_PASSWORD" != "$CANARY_PASSWORD_AGAIN" ]]; then warn "They don't match."
  else break; fi
done
unset CANARY_PASSWORD_AGAIN

stage "Create the Canary User on prod"
say "Runs create-user --canary in $APP's Machine, the password piped in on stdin."
if confirm "Create $CANARY_EMAIL on $APP?"; then
  if ! create_canary "$APP"; then
    warn "That didn't work. Create it by hand instead: the CLI asks for the password."
    step "flyctl ssh console -a $APP --pty -C \"/app/.venv/bin/dots-and-dashes create-user --canary --email $CANARY_EMAIL --timezone UTC\""
    pause "Done? Press Enter"
  fi
fi
status=$(login_status "https://$APP.fly.dev")
if [[ "$status" == 303 ]]; then
  say "${GREEN}✓${RESET} The Canary User logs in to prod (303)."
  EVIDENCE+=("Canary User $CANARY_EMAIL logs in to https://$APP.fly.dev: POST /login answered 303")
else
  warn "Logging in as the Canary User on prod answered $status, not 303."
  warn "The check would fail. Fix this before going on (Ctrl-C), then re-run."
  pause
fi
pause

stage "A Canary User on dev, for staging incidents (optional)"
say "The canary runs on prod only. To make dev's alerts fire on a staged"
say "incident, something must save Entries on dev: the firing test at the end,"
say "and the runbook's k6 command, log in as a Canary User of dev's own."
if confirm "Create $CANARY_EMAIL on $DEV_APP too, with the same password?"; then
  create_canary "$DEV_APP" || warn "Not created on dev; the firing test will be skipped."
fi
pause

stage "Store the password as a Synthetic Monitoring secret"
say "The canary script reads it with secrets.get('canary-password')."
open_url "$GRAFANA_URL/$SM_PATH/config/secrets"
step "This is Testing & synthetics → Synthetics → Config → the Secrets tab."
step "Create a secret named exactly: canary-password"
step "Description: the Canary User's password (scripts/provision-canary)."
step "Value: the canary password you just typed. Save it."
note "Not sure of the current button names: the Synthetic Monitoring app hides the"
note "Secrets tab behind a feature flag. If your stack has no Secrets tab, stop here"
note "and say so on the PR; the script needs a secret source to read the password."
pause "Saved? Press Enter"

stage "Create the canary check"
open_url "$GRAFANA_URL/$SM_PATH/checks/new/scripted"
step "This is Synthetics → Checks → Create new check → Scripted."
step "Job name: $CANARY_JOB (the alert and dashboard select on it)."
step "Target / instance: https://$APP.fly.dev"
if copy_file monitoring/canary.js; then
  step "Script: replace the example with monitoring/canary.js, now on your clipboard."
else
  step "Script: replace the example with the whole of monitoring/canary.js."
fi
step "Probe locations: one, the nearest to Fly's iad (e.g. North Virginia)."
step "Frequency: 1 minute. If the form has a Test button, run it: it should pass."
step "Save the check. Its page's URL ends in /checks/<id>."
note "Field names here are from the Synthetic Monitoring app's code; the form's"
note "layout may differ. Each run counts against your plan's execution quota."
ask CANARY_CHECK_ID "The check's ID (the number at the end of its URL):"
write_env CANARY_CHECK_ID "$CANARY_CHECK_ID"
EVIDENCE+=("Synthetic Monitoring check $CANARY_CHECK_ID: $GRAFANA_URL/$SM_PATH/checks/$CANARY_CHECK_ID")

stage "A Grafana token to import the alerts and dashboard"
open_url "$GRAFANA_URL/org/serviceaccounts"
step "This is Administration → Users and access → Service accounts."
step "Add service account: name dots-and-dashes-provisioning, role Admin."
step "On it: Add service account token, no expiry needed, Generate, copy it."
note "Admin, because the alert provisioning API needs it. Delete the token after."
ask_secret GRAFANA_TOKEN "Service account token (hidden):"
AUTH_FILE=$(mktemp)
chmod 600 "$AUTH_FILE"
trap 'rm -f "$AUTH_FILE"' EXIT
printf 'Authorization: Bearer %s\n' "$GRAFANA_TOKEN" > "$AUTH_FILE"
unset GRAFANA_TOKEN
code=$(grafana GET api/folders -o /dev/null -w '%{http_code}')
if [[ "$code" != 200 ]]; then
  warn "Grafana answered $code to the token: check the URL and token, then re-run."
  exit 1
fi
say "${GREEN}✓${RESET} The token works."

stage "Import the alert rules and dashboard"
if [[ "$(grafana GET api/datasources/uid/grafanacloud-prom -o /dev/null -w '%{http_code}')" == 200 ]]; then
  PROMETHEUS_UID=grafanacloud-prom
  say "Prometheus data source: grafanacloud-prom, Grafana Cloud's own."
else
  note "No data source with UID grafanacloud-prom. Your Prometheus data sources:"
  grafana GET api/datasources | python3 -c '
import json, sys
for d in json.load(sys.stdin):
    if d.get("type") == "prometheus":
        print("    ", d["uid"], " ", d["name"])'
  ask PROMETHEUS_UID "UID of the one holding prod's metrics (grafanacloud-<stack>-prom):"
fi
say "Folder $FOLDER_UID:"
grafana POST api/folders -o /dev/null -w '  answered %{http_code} (409 or 412: already there)\n' \
  -d "{\"uid\":\"$FOLDER_UID\",\"title\":\"Dots & Dashes\"}"
say "Rule group $RULE_GROUP, from monitoring/alert-rules.json:"
# X-Disable-Provenance keeps the rules editable in the UI.
rules=$(render monitoring/alert-rules.json | grafana PUT \
  "api/v1/provisioning/folder/$FOLDER_UID/rule-groups/$RULE_GROUP" \
  -H 'X-Disable-Provenance: true' --data-binary @- -w '\n%{http_code}')
if [[ "${rules##*$'\n'}" != 200 ]]; then
  warn "Grafana refused the rule group:"; say "$rules"; exit 1
fi
uids=$(grafana GET "api/v1/provisioning/folder/$FOLDER_UID/rule-groups/$RULE_GROUP" \
  | python3 -c 'import json, sys; print(" ".join(r["uid"] for r in json.load(sys.stdin)["rules"]))')
say "${GREEN}✓${RESET} Rules: $uids"
EVIDENCE+=("Alert rule UIDs in folder $FOLDER_UID, group $RULE_GROUP: $uids")
say "Dashboard, from monitoring/dashboard.json:"
dashboard=$(printf '{"dashboard":%s,"folderUid":"%s","overwrite":true}' \
  "$(cat monitoring/dashboard.json)" "$FOLDER_UID" | grafana POST api/dashboards/db --data-binary @-)
dashboard_url=$(json_field '["url"]' <<<"$dashboard" 2>/dev/null || true)
if [[ -z "$dashboard_url" ]]; then
  warn "Grafana refused the dashboard:"; say "$dashboard"; exit 1
fi
say "${GREEN}✓${RESET} $GRAFANA_URL$dashboard_url"
EVIDENCE+=("Dashboard: $GRAFANA_URL$dashboard_url")
open_url "$GRAFANA_URL$dashboard_url"
step "Pick Environment prod: Saves by outcome should show the canary's saves"
step "within a few minutes, and Canary pass rate should sit at 100%."
note "Where alerts are sent (the On-call contact point) is issue #22's; until then"
note "they show under Alerting → Alert rules, and in the default contact point."
pause

stage "Firing test: stage save failures on dev"
say "Sets CHAOS_SAVE_ERROR_RATE=0.5 on $DEV_APP (it restarts), saves 30 Entries"
say "there as the Canary User, waits for 'Save failures (dev)' to fire, then unsets"
say "the switch (another restart). Needs the Canary User on dev from stage 4."
if [[ "$(login_status "https://$DEV_APP.fly.dev")" != 303 ]]; then
  warn "The Canary User can't log in to dev, so the firing test is skipped."
  EVIDENCE+=("Firing test: skipped (no Canary User on dev)")
elif confirm "Stage it now? It takes about five minutes."; then
  flyctl secrets set -a "$DEV_APP" CHAOS_SAVE_ERROR_RATE=0.5
  jar=$(mktemp)
  printf '%s' "$CANARY_PASSWORD" | curl -s -o /dev/null -c "$jar" \
    --data-urlencode "email=$CANARY_EMAIL" --data-urlencode "password@-" "https://$DEV_APP.fly.dev/login"
  saved=0 failed=0
  for _ in $(seq 1 30); do
    body=$(curl -s -b "$jar" -H 'Content-Type: application/json' -d '{"text":"canary check"}' \
      -w '\n%{http_code}' "https://$DEV_APP.fly.dev/api/entries")
    if [[ "${body##*$'\n'}" == 201 ]]; then
      saved=$((saved + 1))
      id=$(json_field '["id"]' <<<"${body%$'\n'*}")
      curl -s -o /dev/null -b "$jar" -X DELETE "https://$DEV_APP.fly.dev/api/entries/$id"
    else
      failed=$((failed + 1))
    fi
  done
  rm -f "$jar"
  say "Saves on dev: $saved saved, $failed failed."
  say "Waiting for the rule to fire (it evaluates every minute, then holds 1m)…"
  state=""
  for _ in $(seq 1 20); do
    state=$(grafana GET api/prometheus/grafana/api/v1/rules | python3 -c '
import json, sys
for g in json.load(sys.stdin)["data"]["groups"]:
    for r in g["rules"]:
        if r["name"] == "Save failures (dev)":
            print(r["state"])' 2>/dev/null || true)
    note "  Save failures (dev): ${state:-unknown}"
    [[ "$state" == firing ]] && break
    sleep 30
  done
  EVIDENCE+=("Firing test on dev: $saved saved, $failed failed; 'Save failures (dev)' state: ${state:-unknown} at $(date -u +%FT%TZ)")
  say "Ending the staged incident."
  flyctl secrets unset -a "$DEV_APP" CHAOS_SAVE_ERROR_RATE
  open_url "$GRAFANA_URL/alerting/list"
  step "If it fired, the alert rule list shows it; it resolves within ~10 minutes."
fi
pause

unset CANARY_PASSWORD
finish
say "Paste this on the PR as the evidence:"
printf '\n'
for line in "${EVIDENCE[@]}"; do printf '  - %s\n' "$line"; done
printf '\n'
say "Delete the dots-and-dashes-provisioning token once you're done with it."
printf '\n'
}

run_wizard "$@"; exit
