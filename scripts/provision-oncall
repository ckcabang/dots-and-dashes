#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────



# One-time setup of the On-call agent (issue #22; run it for issue #80): the
# credentials and Grafana wiring that let an alert wake the agent in GitHub
# Actions (.github/workflows/on-call.yml). Run it from main, once the On-call
# workflow is there and scripts/provision-canary has imported the alert rules.
# docs/runbooks/README.md#the-on-call-agent describes what it sets up.
#
#   - GRAFANA_URL as a GitHub variable (and in .env)
#   - a Viewer-role service account token, GRAFANA_VIEWER_TOKEN, as a GitHub
#     secret and in the gitignored .env, for local agents
#   - the Claude API key, ANTHROPIC_API_KEY, as a GitHub secret
#   - the Fly deploy tokens the remedies use, FLY_API_TOKEN and FLY_PROD_API_TOKEN
#   - the GitHub token the contact point dispatches with, held on it only
#   - the webhook contact point, the notification policy routing folder
#     "Dots & Dashes" to it, and a test notification
#
# Every evidence line is read back from the service: gh's secret and variable
# listings, Grafana's API, Fly's token list, GitHub's run list. A value you
# type is never printed. Safe to re-run: it updates what is already there.

REPO=ckcabang/dots-and-dashes
DEV_APP=dots-and-dashes-dev
PROD_APP=dots-and-dashes
FOLDER_TITLE="Dots & Dashes"
CONTACT_POINT=dots-and-dashes-on-call
VIEWER_ACCOUNT=dots-and-dashes-agents
DISPATCH_TOKEN_NAME=dots-and-dashes-on-call-dispatch
DISPATCH_URL="https://api.github.com/repos/$REPO/dispatches"
EVIDENCE=()

# with_timeout SECONDS CMD...: CMD, killed after SECONDS where `timeout` exists.
with_timeout() {
  local seconds="$1"; shift
  if command -v timeout >/dev/null 2>&1; then timeout "$seconds" "$@"; else "$@"; fi
}

# env_preflight: stop before the first prompt if write_env can't write
# ENV_FILE, rather than after a token is typed. A sandbox can leave an empty
# read-only (0444) .env placeholder in the checkout.
env_preflight() {
  local dir; dir=$(dirname "$ENV_FILE")
  [[ "$dir" == . ]] && dir=$PWD
  if [[ -e "$ENV_FILE" && ! -w "$ENV_FILE" ]]; then
    warn "$ENV_FILE isn't writable, and this wizard saves the Viewer token there."
    step "Fix it: chmod 600 $ENV_FILE"
    step "Then re-run this wizard. Nothing has been changed."
    exit 1
  fi
  if [[ ! -e "$ENV_FILE" && ! -w "$dir" ]]; then
    warn "$ENV_FILE doesn't exist and $dir isn't writable, so this wizard can't create it."
    step "Fix it: chmod u+w $dir"
    step "Then re-run this wizard. Nothing has been changed."
    exit 1
  fi
}

# Files the EXIT trap removes: the tokens' header files and request bodies.
AUTH_FILE=""
VIEWER_AUTH_FILE=""
TMP_FILES=()

cleanup() {
  trap '' INT TERM
  rm -f "$AUTH_FILE" "$VIEWER_AUTH_FILE" "${TMP_FILES[@]}"
}

# private_file: a new 0600 temp file, removed on exit.
private_file() {
  local file; file=$(mktemp)
  chmod 600 "$file"
  TMP_FILES+=("$file")
  printf '%s' "$file"
}

# header_file TOKEN: a 0600 file holding the Authorization header, so the token
# never shows in the process list.
header_file() {
  local file; file=$(private_file)
  printf 'Authorization: Bearer %s\n' "$1" > "$file"
  printf '%s' "$file"
}

# grafana METHOD PATH [curl args...]: Grafana's HTTP API as the Admin token.
grafana() {
  local method="$1" path="$2"; shift 2
  curl -sS -X "$method" -H "@$AUTH_FILE" -H 'Content-Type: application/json' \
    "$GRAFANA_URL/$path" "$@"
}

# as_viewer METHOD PATH [curl args...]: the same, as the Viewer token.
as_viewer() {
  local method="$1" path="$2"; shift 2
  curl -sS -X "$method" -H "@$VIEWER_AUTH_FILE" -H 'Content-Type: application/json' \
    "$GRAFANA_URL/$path" "$@"
}

json_field() { python3 -c "import json,sys; print(json.load(sys.stdin)$1)"; }

# secret_line NAME: NAME's line in `gh secret list`, as GitHub reports it.
secret_line() {
  gh secret list --repo "$REPO" | grep -E "^$1[[:space:]]" || echo "$1: not in gh secret list"
}

# variable_line NAME: NAME's line in `gh variable list`.
variable_line() {
  gh variable list --repo "$REPO" | grep -E "^$1[[:space:]]" || echo "$1: not in gh variable list"
}

# viewer_probe: what Grafana answers the Viewer token to a read and a write.
# The write asks for a folder; should it ever succeed, it is deleted again.
viewer_probe() {
  local read_code write_code body uid
  read_code=$(as_viewer GET api/folders -o /dev/null -w '%{http_code}')
  body=$(private_file)
  write_code=$(as_viewer POST api/folders -o "$body" -w '%{http_code}' \
    -d '{"title":"dots-and-dashes viewer write probe"}')
  if [[ "$write_code" == 200 ]]; then
    uid=$(json_field '["uid"]' < "$body" 2>/dev/null || true)
    [[ -n "$uid" ]] && grafana DELETE "api/folders/$uid" -o /dev/null
    warn "The token could create a folder (deleted again): it isn't Viewer-only."
  fi
  say "GET api/folders answered $read_code (want 200); POST api/folders answered $write_code (want 403)."
  EVIDENCE+=("Viewer token: GET api/folders answered $read_code, POST api/folders answered $write_code")
}

# fly_token_stage SECRET APP: keep SECRET if it's set, or make APP a new deploy
# token and set it straight from flyctl, never shown. Then read both back.
fly_token_stage() {
  local secret="$1" app="$2" token out
  if gh secret list --repo "$REPO" | grep -qE "^${secret}[[:space:]]" \
     && ! confirm "$secret is already set (CD uses it too). Replace it with a new deploy token for $app?"; then
    say "Keeping $secret."
  else
    say "Creating a deploy token for $app (valid a year) and setting it as $secret."
    if ! token=$(flyctl tokens create deploy -a "$app" -x 8760h --name "github-actions" 2>/dev/null); then
      warn "flyctl couldn't create the token. Create one yourself, then re-run:"
      step "flyctl tokens create deploy -a $app -x 8760h | gh secret set $secret --repo $REPO"
    else
      set_secret "$secret" "$token"
    fi
    token=""
  fi
  say "GitHub: $(secret_line "$secret")"
  EVIDENCE+=("gh secret list: $(secret_line "$secret")")
  say "Fly's tokens for $app:"
  if out=$(flyctl tokens list -a "$app" 2>&1); then
    printf '%s\n' "$out" | sed 's/^/    /'
    EVIDENCE+=("flyctl tokens list -a $app: $(printf '%s' "$out" | paste -sd'|' | sed 's/|/ | /g')")
  else
    warn "flyctl tokens list -a $app failed: $out"
    EVIDENCE+=("flyctl tokens list -a $app: failed")
  fi
}

# contact_point_json: the contact point's provisioning body, the dispatch token
# read from DISPATCH_TOKEN in the environment and the payload from the repo.
contact_point_json() {
  NAME="$CONTACT_POINT" URL="$DISPATCH_URL" UID_="${1:-}" python3 -c '
import json, os
body = {
    "name": os.environ["NAME"],
    "type": "webhook",
    "disableResolveMessage": False,
    "settings": {
        "url": os.environ["URL"],
        "httpMethod": "POST",
        "authorization_scheme": "Bearer",
        "authorization_credentials": os.environ["DISPATCH_TOKEN"],
        "payload": {"template": open("monitoring/on-call-payload.tmpl").read()},
    },
}
if os.environ["UID_"]:
    body["uid"] = os.environ["UID_"]
print(json.dumps(body))'
}

# contact_point_report: the contact point as Grafana's provisioning API reports it.
contact_point_report() {
  grafana GET "api/v1/provisioning/contact-points?name=$CONTACT_POINT" | python3 -c '
import json, sys
points = json.load(sys.stdin)
if not points:
    print("no contact point named so"); sys.exit()
p = points[0]
s = p.get("settings", {})
payload = (s.get("payload") or {}).get("template", "")
same = payload.strip() == open("monitoring/on-call-payload.tmpl").read().strip()
cred = s.get("authorization_credentials")
parts = [
    "contact point %s (uid %s, %s): %s %s" % (p["name"], p["uid"], p["type"], s.get("httpMethod"), s.get("url")),
    "authorization %s, credentials %s" % (
        s.get("authorization_scheme"), "set (Grafana shows %r)" % cred if cred else "NOT set"),
    "payload template %s" % ("matches monitoring/on-call-payload.tmpl" if same else "MISSING or different"),
]
print("; ".join(parts))'
}

run_wizard() {

cd "$(dirname "$0")/.."

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

TOTAL_STAGES=9

env_preflight

banner "The On-call agent: credentials and Grafana wiring"

stage "Tools, logins and your Grafana stack"
for tool in gh flyctl curl python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    warn "$tool isn't installed. Install it, then re-run this wizard."
    exit 1
  fi
done
if ! gh auth status >/dev/null 2>&1; then
  say "Log in to GitHub in the browser that opens."
  gh auth login --web
fi
if ! flyctl auth whoami >/dev/null 2>&1; then
  say "Log in to Fly.io in the browser that opens."
  flyctl auth login
fi
say "GitHub: $(gh api user --jq .login). Fly.io: $(flyctl auth whoami)."
if ! gh api "repos/$REPO/contents/.github/workflows/on-call.yml" --jq .path >/dev/null 2>&1; then
  warn "main has no .github/workflows/on-call.yml yet: merge #22 first, then re-run."
  exit 1
fi
say "Your Grafana Cloud stack's URL is the address you open Grafana at."
ask GRAFANA_URL "Grafana stack URL (https://<stack>.grafana.net):"
GRAFANA_URL=${GRAFANA_URL%/}
write_env GRAFANA_URL "$GRAFANA_URL"
set_var GRAFANA_URL "$GRAFANA_URL"
say "GitHub: $(variable_line GRAFANA_URL)"
EVIDENCE+=("gh variable list: $(variable_line GRAFANA_URL)")

stage "A Grafana Admin token for the setup"
open_url "$GRAFANA_URL/org/serviceaccounts"
step "This is Administration → Users and access → Service accounts."
step "Open dots-and-dashes-provisioning (scripts/provision-canary made it, role Admin),"
step "or add it: Add service account, name dots-and-dashes-provisioning, role Admin."
step "Add service account token, Generate, copy it."
note "It creates the Viewer account, the contact point and the policy. Delete it after."
ask_secret ADMIN_TOKEN "Admin service account token (hidden):"
AUTH_FILE=$(header_file "$ADMIN_TOKEN")
unset ADMIN_TOKEN
code=$(grafana GET api/v1/provisioning/contact-points -o /dev/null -w '%{http_code}')
if [[ "$code" != 200 ]]; then
  warn "Grafana answered $code to the provisioning API: check the URL and that the token is Admin."
  exit 1
fi
say "${GREEN}✓${RESET} The token reads the provisioning API (200)."

stage "The Viewer-role token for agents"
say "Service account $VIEWER_ACCOUNT, role Viewer: the On-call agent reads Grafana with"
say "its token in GitHub Actions, and local agents read it from $ENV_FILE."
account=$(grafana GET "api/serviceaccounts/search?query=$VIEWER_ACCOUNT" | ACCOUNT="$VIEWER_ACCOUNT" python3 -c '
import json, os, sys
for a in json.load(sys.stdin).get("serviceAccounts", []):
    if a["name"] == os.environ["ACCOUNT"]:
        print(a["id"], a["role"])' || true)
if [[ -z "$account" ]]; then
  say "Creating it."
  account_id=$(grafana POST api/serviceaccounts \
    -d "{\"name\":\"$VIEWER_ACCOUNT\",\"role\":\"Viewer\",\"isDisabled\":false}" | json_field '["id"]')
else
  account_id=${account%% *}
  if [[ "${account#* }" != Viewer ]]; then
    warn "It exists with role ${account#* }: setting it back to Viewer."
    grafana PATCH "api/serviceaccounts/$account_id" -d '{"role":"Viewer"}' -o /dev/null
  fi
fi
viewer_token=""
existing=$(_existing GRAFANA_VIEWER_TOKEN || true)
if [[ -n "$existing" ]]; then
  VIEWER_AUTH_FILE=$(header_file "$existing")
  if [[ "$(as_viewer GET api/folders -o /dev/null -w '%{http_code}')" == 200 ]] \
     && confirm "$ENV_FILE already holds a Viewer token that works. Keep it?"; then
    viewer_token="$existing"
  fi
fi
if [[ -z "$viewer_token" ]]; then
  say "Adding a token to $VIEWER_ACCOUNT (Grafana shows it once; it goes straight to $ENV_FILE and GitHub)."
  viewer_token=$(grafana POST "api/serviceaccounts/$account_id/tokens" \
    -d "{\"name\":\"agents-$(date -u +%Y%m%d%H%M%S)\"}" | json_field '["key"]')
  VIEWER_AUTH_FILE=$(header_file "$viewer_token")
fi
write_env GRAFANA_VIEWER_TOKEN "$viewer_token"
set_secret GRAFANA_VIEWER_TOKEN "$viewer_token"
viewer_token=""; existing=""; unset GRAFANA_VIEWER_TOKEN
report=$(grafana GET "api/serviceaccounts/search?query=$VIEWER_ACCOUNT" | ACCOUNT="$VIEWER_ACCOUNT" python3 -c '
import json, os, sys
for a in json.load(sys.stdin).get("serviceAccounts", []):
    if a["name"] == os.environ["ACCOUNT"]:
        print("service account %s (id %s): role %s, %s token(s), disabled %s" % (
            a["name"], a["id"], a["role"], a.get("tokens", 0), a.get("isDisabled")))')
say "Grafana: $report"
EVIDENCE+=("GET api/serviceaccounts/search?query=$VIEWER_ACCOUNT: $report")
say "GitHub: $(secret_line GRAFANA_VIEWER_TOKEN)"
EVIDENCE+=("gh secret list: $(secret_line GRAFANA_VIEWER_TOKEN)")
viewer_probe
pause

stage "The Claude API key"
say "The On-call workflow runs Claude Code with an Anthropic API key."
open_url "https://console.anthropic.com/settings/keys"
step "Create Key, name it dots-and-dashes-on-call, copy it."
note "Each incident costs a few dollars at most: the workflow caps a run at \$10."
ask_secret CLAUDE_KEY "Anthropic API key (hidden):"
key_file=$(private_file)
printf 'x-api-key: %s\n' "$CLAUDE_KEY" > "$key_file"
code=$(curl -sS -o /dev/null -w '%{http_code}' -H "@$key_file" -H 'anthropic-version: 2023-06-01' \
  https://api.anthropic.com/v1/models || true)
if [[ "$code" != 200 ]]; then
  warn "Anthropic answered $code to the key: check it, then re-run."
  exit 1
fi
set_secret ANTHROPIC_API_KEY "$CLAUDE_KEY"
unset CLAUDE_KEY
say "Anthropic: GET /v1/models answered $code with the key."
say "GitHub: $(secret_line ANTHROPIC_API_KEY)"
EVIDENCE+=("Anthropic GET /v1/models with the key answered $code; gh secret list: $(secret_line ANTHROPIC_API_KEY)")
pause

stage "The Fly tokens the remedies use"
say "The remedies run with CD's deploy tokens, one per app: they roll back, set a"
say "secret and redeploy, which a deploy token scoped to its app can do."
fly_token_stage FLY_API_TOKEN "$DEV_APP"
fly_token_stage FLY_PROD_API_TOKEN "$PROD_APP"
pause

stage "The GitHub token the contact point dispatches with"
say "Grafana POSTs each notification to $DISPATCH_URL with this token."
open_url "https://github.com/settings/personal-access-tokens/new"
step "Fine-grained token. Token name: $DISPATCH_TOKEN_NAME."
step "Expiration: 90 days or so (re-run this wizard to rotate it)."
step "Resource owner: ckcabang. Repository access: Only select repositories → dots-and-dashes."
step "Permissions → Repository permissions → Contents: Read and write. Nothing else."
note "Contents read and write is the least GitHub accepts for repository_dispatch."
step "Generate token, copy it."
note "It's held only on the contact point, never in a file or a GitHub secret."
ask_secret DISPATCH_TOKEN "Fine-grained token (hidden):"
gh_auth=$(header_file "$DISPATCH_TOKEN")
code=$(curl -sS -o /dev/null -w '%{http_code}' -H "@$gh_auth" "https://api.github.com/repos/$REPO" || true)
if [[ "$code" != 200 ]]; then
  warn "GitHub answered $code to the token for $REPO: check it has this repository."
  exit 1
fi
say "${GREEN}✓${RESET} GitHub: GET /repos/$REPO answered $code with the token."
EVIDENCE+=("Dispatch token: GET /repos/$REPO answered $code; it sends repository_dispatch in the test below")

stage "The contact point"
say "Webhook $CONTACT_POINT: POST to $DISPATCH_URL, Bearer the token, with the"
say "custom payload in monitoring/on-call-payload.tmpl."
uid=$(grafana GET "api/v1/provisioning/contact-points?name=$CONTACT_POINT" \
  | python3 -c 'import json,sys; p=json.load(sys.stdin); print(p[0]["uid"] if p else "")' || true)
body=$(private_file)
DISPATCH_TOKEN="$DISPATCH_TOKEN" contact_point_json "$uid" > "$body"
unset DISPATCH_TOKEN
if [[ -n "$uid" ]]; then
  code=$(grafana PUT "api/v1/provisioning/contact-points/$uid" -H 'X-Disable-Provenance: true' \
    --data-binary "@$body" -o /dev/null -w '%{http_code}')
else
  code=$(grafana POST api/v1/provisioning/contact-points -H 'X-Disable-Provenance: true' \
    --data-binary "@$body" -o /dev/null -w '%{http_code}')
fi
rm -f "$body"
if [[ "$code" != 2* ]]; then
  warn "Grafana answered $code to the contact point."; exit 1
fi
report=$(contact_point_report)
say "Grafana: $report"
EVIDENCE+=("GET api/v1/provisioning/contact-points?name=$CONTACT_POINT: $report")
if [[ "$report" == *MISSING* ]]; then
  warn "Grafana kept no custom payload: this stack's webhook may not support one."
  warn "Say so on #80: the bridge then needs a relay instead (docs/runbooks)."
fi
pause

stage "The notification policy"
say "A route sending every alert in folder \"$FOLDER_TITLE\" to $CONTACT_POINT, grouped"
say "by alertname and env. It continues to the routes after it, so the default"
say "contact point still notifies you too."
if ! confirm "Add (or replace) that route in Grafana's notification policy tree? Other routes are kept."; then
  warn "No route: alerts won't reach the On-call agent. Re-run when ready."
  exit 1
fi
tree=$(private_file)
grafana GET api/v1/provisioning/policies | RECEIVER="$CONTACT_POINT" FOLDER="$FOLDER_TITLE" python3 -c '
import json, os, sys
tree = json.load(sys.stdin)
routes = [r for r in tree.get("routes") or [] if r.get("receiver") != os.environ["RECEIVER"]]
routes.insert(0, {
    "receiver": os.environ["RECEIVER"],
    "object_matchers": [["grafana_folder", "=", os.environ["FOLDER"]]],
    "group_by": ["alertname", "env"],
    "continue": True,
})
tree["routes"] = routes
print(json.dumps(tree))' > "$tree"
code=$(grafana PUT api/v1/provisioning/policies -H 'X-Disable-Provenance: true' \
  --data-binary "@$tree" -o /dev/null -w '%{http_code}')
if [[ "$code" != 2* ]]; then
  warn "Grafana answered $code to the policy tree."; exit 1
fi
report=$(grafana GET api/v1/provisioning/policies | RECEIVER="$CONTACT_POINT" python3 -c '
import json, os, sys
tree = json.load(sys.stdin)
found = [r for r in tree.get("routes") or [] if r.get("receiver") == os.environ["RECEIVER"]]
print("; ".join(
    "route to %s matching %s, group_by %s, continue %s" % (
        r["receiver"], r.get("object_matchers"), r.get("group_by"), r.get("continue", False))
    for r in found) or "no route to it")')
say "Grafana: $report"
EVIDENCE+=("GET api/v1/provisioning/policies: $report")
rules=$(grafana GET api/v1/provisioning/alert-rules | python3 -c '
import json, sys
print(len([r for r in json.load(sys.stdin) if r.get("folderUID") == "dots-and-dashes"]))' || echo "?")
say "Alert rules in folder dots-and-dashes it routes: $rules."
EVIDENCE+=("Alert rules in folder dots-and-dashes (GET api/v1/provisioning/alert-rules): $rules")
pause

stage "Test notification"
say "The Test button sends Grafana's TestAlert. It should start an On-call run that"
say "wakes no agent and says so in its summary."
started=$(date -u +%FT%TZ)
open_url "$GRAFANA_URL/alerting/notifications"
step "This is Alerting → Contact points. Find $CONTACT_POINT and choose Edit."
step "Press Test on the Webhook integration, then Send test notification."
note "Not sure of the exact button names in your Grafana version; it's the contact point's Test."
pause "Sent it? Press Enter, and this waits up to 3 minutes for the run."
run=""
for _ in $(seq 1 18); do
  run=$(gh run list --repo "$REPO" --workflow on-call.yml --event repository_dispatch --limit 5 \
    --json databaseId,createdAt --jq "[.[] | select(.createdAt >= \"$started\")] | .[0].databaseId // empty" || true)
  [[ -n "$run" ]] && break
  sleep 10
done
if [[ -z "$run" ]]; then
  warn "No repository_dispatch run started. Check the contact point's last delivery error"
  warn "in Alerting → Contact points, then re-run this wizard."
  EVIDENCE+=("Test notification: no repository_dispatch run started after $started")
else
  with_timeout 300 gh run watch "$run" --repo "$REPO" >/dev/null 2>&1 || true
  line=$(gh run list --repo "$REPO" --workflow on-call.yml --event repository_dispatch --limit 5 \
    | grep -F "$run" || true)
  url=$(gh run view "$run" --repo "$REPO" --json url --jq .url)
  say "GitHub: $line"
  say "$url"
  EVIDENCE+=("gh run list --event repository_dispatch: $line ($url)")
fi
pause

finish
say "Paste this on #80 as the evidence:"
printf '\n'
for line in "${EVIDENCE[@]}"; do printf '  - %s\n' "$line"; done
printf '\n'
say "Delete the dots-and-dashes-provisioning token's new key once you're done with it."
printf '\n'
}

run_wizard "$@"; exit
