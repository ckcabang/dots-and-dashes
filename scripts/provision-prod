#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM${e}[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
# shellcheck disable=SC2329 # library function this wizard doesn't call
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
# shellcheck disable=SC2329 # library function this wizard doesn't call
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────


# One-time setup of prod on Fly.io (issue #8): the dots-and-dashes app, its own
# Postgres app dots-and-dashes-db (ADR-0003), their secrets, the
# FLY_PROD_API_TOKEN that .github/workflows/deploy-prod.yml deploys with, a
# first deploy and the User. Run it once deploy-prod.yml is on main and dev has
# deployed at least once. Safe to re-run: each stage skips what already exists.
# Secrets go to Fly (and GitHub), never to .env.

APP=dots-and-dashes
DB_APP=dots-and-dashes-db
REGION=iad

app_exists() { flyctl apps list --json 2>/dev/null | grep -q "\"$1\""; }
# has_secret APP NAME
has_secret() { flyctl secrets list -a "$1" --json 2>/dev/null | grep -q "\"$2\""; }

run_wizard() {

cd "$(dirname "$0")/.."

TOTAL_STAGES=11

banner "Prod on Fly.io: dots-and-dashes"

stage "Fly CLI, GitHub CLI and login"
if ! command -v flyctl >/dev/null 2>&1; then
  warn "flyctl isn't installed. Install it, open a new shell, then re-run this wizard:"
  step "curl -L https://fly.io/install.sh | sh"
  exit 1
fi
if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
  warn "The first deploy runs through GitHub Actions, so gh must be installed and"
  warn "logged in (gh auth login). Then re-run this wizard."
  exit 1
fi
if ! flyctl auth whoami >/dev/null 2>&1; then
  say "Log in to Fly.io in the browser that opens."
  flyctl auth login
fi
say "Logged in to Fly.io as $(flyctl auth whoami)."
note "Organizations you belong to:"
flyctl orgs list
ask FLY_ORG "Organization slug for the prod apps, the same as dev's [personal]:"
FLY_ORG=${FLY_ORG:-personal}

stage "Create the two apps"
say "$DB_APP holds prod's Postgres; $APP serves the journal."
for app in "$DB_APP" "$APP"; do
  if app_exists "$app"; then
    note "$app already exists."
  else
    flyctl apps create "$app" --org "$FLY_ORG"
  fi
done
pause

stage "Database volume and private address"
if flyctl volumes list -a "$DB_APP" --json | grep -q '"pgdata"'; then
  note "Volume pgdata already exists."
else
  say "A 1GB volume in $REGION holds the data; Fly snapshots it daily."
  flyctl volumes create pgdata -a "$DB_APP" -r "$REGION" -s 1 -y
fi
if flyctl ips list -a "$DB_APP" --json | grep -q 'private_v6'; then
  note "Private (Flycast) address already allocated."
else
  say "A private Flycast address: the app reaches Postgres at $DB_APP.flycast."
  flyctl ips allocate-v6 --private -a "$DB_APP"
fi
pause

stage "Database password"
if has_secret "$DB_APP" POSTGRES_PASSWORD; then
  note "POSTGRES_PASSWORD is already set, and $APP's DATABASE_URL carries it."
  note "Postgres only reads it on first start, so the wizard never changes it."
else
  say "Generating a password, stored only as Fly secrets: POSTGRES_PASSWORD on"
  say "$DB_APP and the DATABASE_URL that $APP connects with."
  pw=$(openssl rand -hex 24)
  # User and database are POSTGRES_USER and POSTGRES_DB in fly.prod-db.toml.
  printf 'POSTGRES_PASSWORD=%s\n' "$pw" | flyctl secrets import --stage -a "$DB_APP"
  printf 'DATABASE_URL=postgresql+psycopg://dots:%s@%s.flycast:5432/dots_and_dashes\n' "$pw" "$DB_APP" \
    | flyctl secrets import --stage -a "$APP"
  unset pw
fi
pause

stage "App secrets"
if has_secret "$APP" SESSION_SECRET; then
  note "SESSION_SECRET is already set (changing it would log everyone out)."
else
  say "Generating SESSION_SECRET, which signs the login cookie. It isn't dev's,"
  say "so a dev login cookie never works on prod."
  printf 'SESSION_SECRET=%s\n' "$(openssl rand -hex 32)" | flyctl secrets import --stage -a "$APP"
fi
if has_secret "$APP" FLAG_MONTHLY_REVIEW; then
  note "FLAG_MONTHLY_REVIEW is already set; left as is (On-call may have turned it off)."
elif confirm "Turn the Monthly Review flag on in prod?"; then
  flyctl secrets set --stage -a "$APP" FLAG_MONTHLY_REVIEW=on
else
  flyctl secrets set --stage -a "$APP" FLAG_MONTHLY_REVIEW=off
fi
pause

stage "Telemetry to Grafana Cloud"
say "The save alerts read prod's telemetry, sent over OTLP to Grafana Cloud."
say "Without these two secrets prod runs the same but exports nothing."
if has_secret "$APP" OTEL_EXPORTER_OTLP_ENDPOINT && has_secret "$APP" OTEL_EXPORTER_OTLP_HEADERS; then
  note "OTEL_EXPORTER_OTLP_ENDPOINT and OTEL_EXPORTER_OTLP_HEADERS are already set."
elif confirm "Set them now? (Same Grafana Cloud stack as dev is fine.)"; then
  open_url "https://grafana.com/auth/sign-in"
  step "Open your stack's OpenTelemetry tile → Configure, and generate a token."
  step "It shows OTEL_EXPORTER_OTLP_ENDPOINT and OTEL_EXPORTER_OTLP_HEADERS."
  ask OTLP_ENDPOINT "OTEL_EXPORTER_OTLP_ENDPOINT (https://otlp-gateway-<zone>.grafana.net/otlp):"
  ask_secret OTLP_HEADERS "OTEL_EXPORTER_OTLP_HEADERS (Authorization=Basic …, hidden):"
  printf 'OTEL_EXPORTER_OTLP_ENDPOINT=%s\nOTEL_EXPORTER_OTLP_HEADERS=%s\n' "$OTLP_ENDPOINT" "$OTLP_HEADERS" \
    | flyctl secrets import --stage -a "$APP"
  unset OTLP_HEADERS
else
  note "Skipped: set both later with flyctl secrets set -a $APP."
fi
pause

stage "Start prod's Postgres"
say "Deploys the official postgres:17 image to one always-on Machine on the"
say "pgdata volume, with no public IP."
if confirm "Deploy $DB_APP now?"; then
  flyctl deploy --config fly.prod-db.toml --ha=false --no-public-ips
  note "Its addresses (expect one private_v6 and nothing public):"
  flyctl ips list -a "$DB_APP"
fi
pause

stage "Deploy token for GitHub Actions"
say "deploy-prod.yml deploys with FLY_PROD_API_TOKEN, a token that can only"
say "deploy $APP. It reads dev's images with dev's FLY_API_TOKEN."
if ! gh secret list 2>/dev/null | grep -q '^FLY_API_TOKEN\b'; then
  warn "FLY_API_TOKEN, dev's deploy token, is missing: run scripts/provision-dev first."
fi
if gh secret list 2>/dev/null | grep -q '^FLY_PROD_API_TOKEN\b'; then
  note "FLY_PROD_API_TOKEN is already a GitHub secret."
fi
if confirm "Create a new deploy token and store it as FLY_PROD_API_TOKEN?"; then
  token=$(flyctl tokens create deploy -a "$APP" --name "GitHub Actions deploy-prod")
  set_secret FLY_PROD_API_TOKEN "$token"
  unset token
fi
pause

stage "First deploy, through the workflow"
say "Prod runs only images dev has run. This deploys the commit of dev's last"
say "successful deploy with Actions → Deploy to prod, the way every later deploy"
say "and rollback goes. Its release command creates the schema."
version=$(gh run list --workflow deploy-dev.yml --branch main --status success --limit 1 \
  --json headSha --jq '.[0].headSha // empty' 2>/dev/null || true)
if [[ -z "$version" ]]; then
  warn "Dev has no successful deploy yet. Merge to main (or run Deploy to dev), then re-run."
  exit 1
fi
say "Dev's last successful deploy: $version"
if confirm "Deploy $version to prod now?"; then
  # Run ids only grow, so the run this starts is the first one above the newest now.
  before=$(gh run list --workflow deploy-prod.yml --limit 1 --json databaseId --jq '.[0].databaseId // 0')
  gh workflow run deploy-prod.yml --ref main -f version="$version"
  note "Waiting for the run to start…"
  run_id=""
  for _ in $(seq 1 20); do
    run_id=$(gh run list --workflow deploy-prod.yml --limit 5 --json databaseId,displayTitle \
      --jq "[.[] | select(.databaseId > $before and .displayTitle == \"Deploy $version to prod\")][0].databaseId // empty")
    [[ -n "$run_id" ]] && break
    sleep 3
  done
  if [[ -z "$run_id" ]]; then
    warn "The run didn't show up within a minute. Follow it under Actions → Deploy to prod, then re-run this wizard."
    exit 1
  fi
  if ! gh run watch "$run_id" --exit-status; then
    warn "The deploy failed, so prod has no Machine to create your User on yet."
    note "Read why with: gh run view $run_id --log-failed. Fix it, then re-run this wizard."
    exit 1
  fi
fi
pause

stage "Create your User on prod"
say "There's no sign-up page: the User is made with the CLI inside the app's"
say "Machine. It asks for the password; type it there."
ask PROD_EMAIL "Email to log in with:"
ask PROD_TIMEZONE "Your timezone, an IANA name (e.g. America/Los_Angeles):"
if confirm "Create $PROD_EMAIL on $APP?"; then
  flyctl ssh console -a "$APP" --pty \
    -C "/app/.venv/bin/dots-and-dashes create-user --email '$PROD_EMAIL' --timezone '$PROD_TIMEZONE'"
fi
pause

stage "Check prod works"
open_url "https://$APP.fly.dev/login"
step "Log in as $PROD_EMAIL."
step "On today's Daily Log, add a Task and see it saved."
pause "Done? Press Enter"

finish
say "Deploy or roll back prod from Actions → Deploy to prod (docs/runbooks/deploy.md)."
printf '\n'
}

run_wizard "$@"; exit
